# 服务端 Supabase 凭据。绝不能将 service role key 暴露给浏览器。
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek 仅由服务端读取。默认禁用实际调用，review 后再显式设为 true。
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash

# 仅兼容旧项目配置的模型名；新配置优先使用 DEEPSEEK_TEXT_MODEL。
OPENAI_TEXT_MODEL=

# 留待检查点 C 配置，当前不会调用 TTS。
OPENAI_TTS_MODEL=
