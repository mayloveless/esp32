# 服务端 Supabase 凭据。绝不能将 service role key 暴露给浏览器。
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek 仅由服务端读取。默认禁用实际调用，review 后再显式设为 true。
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash

# 仅兼容旧项目配置的模型名；新配置优先使用 DEEPSEEK_TEXT_MODEL。
OPENAI_TEXT_MODEL=

# 硅基流动 TTS 仅由服务端读取。默认禁用实际调用，review 后再显式设为 true。
TTS_ENABLED=false
TTS_PROVIDER=siliconflow
TTS_API_KEY=
TTS_BASE_URL=https://api.siliconflow.cn/v1
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE_PRIMARY=FunAudioLLM/CosyVoice2-0.5B:alex
TTS_VOICE_SECONDARY=FunAudioLLM/CosyVoice2-0.5B:anna

# 仅用于同一可信局域网内的设备 Receiver API。不要提交真实 token。
DEVICE_API_TOKEN=
