+++ b/src/RadioHttpRange.h
@@ -0,0 +1,44 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+// Validate HTTP byte ranges without retaining URLs, headers or audio data.
+namespace radio_http_range {
+struct ByteRange { uint32_t start = 0, end = 0, total = 0; };
+inline bool number(const char*& p, uint32_t& out) {
+    if (*p < '0' || *p > '9') return false;
+    uint32_t value = 0;
+    do {
+        const uint32_t digit = static_cast<uint32_t>(*p - '0');
+        if (value > (UINT32_MAX - digit) / 10) return false;
+        value = value * 10 + digit;
+        ++p;
+    } while (*p >= '0' && *p <= '9');
+    out = value;
+    return true;
+}
+inline bool parse(const char* value, ByteRange& result) {
+    if (!value || std::strncmp(value, "bytes ", 6) != 0) return false;
+    const char* p = value + 6;
+    ByteRange range;
+    if (!number(p, range.start) || *p++ != '-' ||
+        !number(p, range.end) || *p++ != '/' || !number(p, range.total)) return false;
+    while (*p == ' ' || *p == '\t') ++p;
+    if (*p || range.start > range.end || range.end >= range.total) return false;
+    result = range;
+    return true;
+}
+inline bool matches(int status, const ByteRange& range, uint32_t position,
+                    uint32_t length, uint32_t fileSize,
+                    bool hasContentLength, uint32_t contentLength) {
+    if (status != 206 || range.start != position || !range.total ||
+        range.start > range.end || range.end >= range.total ||
+        (fileSize && range.total != fileSize)) return false;
+    // httpRange uses an inclusive end of position + length; UINT32_MAX is open.
+    uint64_t end = length == UINT32_MAX ? range.total - 1 :
+                   static_cast<uint64_t>(position) + length;
+    if (end >= range.total) end = range.total - 1;
+    return range.end == end &&
+           (!hasContentLength || contentLength == range.end - range.start + 1);
+}
+} // namespace radio_http_range
