+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+// Opt-in PCM WAV experiment. Only the finite first response is retained.
+namespace radio_fast_wav {
+constexpr uint32_t kInitialBytes = 8192;
+struct Header {
+    uint32_t dataStart = 0, dataSize = 0, byteRate = 0, sampleRate = 0;
+    uint16_t blockAlign = 0, channels = 0, bits = 0;
+};
+inline uint16_t le16(const uint8_t* p) { return uint16_t(p[0]) | (uint16_t(p[1]) << 8); }
+inline uint32_t le32(const uint8_t* p) {
+    return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+}
+inline bool parse(const uint8_t* data, size_t size, uint32_t fileSize, Header& result) {
+    if (!data || size < 12 || std::memcmp(data, "RIFF", 4) || std::memcmp(data + 8, "WAVE", 4)) return false;
+    const uint64_t riffEnd = uint64_t(le32(data + 4)) + 8;
+    if (riffEnd > fileSize || riffEnd < 12) return false;
+    Header header;
+    bool fmtSeen = false;
+    size_t p = 12;
+    while (p + 8 <= size && p + 8 <= riffEnd) {
+        const uint32_t chunkSize = le32(data + p + 4);
+        const uint64_t end = uint64_t(p) + 8 + chunkSize;
+        if (end > riffEnd) return false;
+        if (!std::memcmp(data + p, "fmt ", 4)) {
+            if (fmtSeen || chunkSize < 16 || end > size || le16(data + p + 8) != 1) return false;
+            header.channels = le16(data + p + 10);
+            header.sampleRate = le32(data + p + 12);
+            header.byteRate = le32(data + p + 16);
+            header.blockAlign = le16(data + p + 20);
+            header.bits = le16(data + p + 22);
+            if ((header.channels != 1 && header.channels != 2) || !header.sampleRate || header.byteRate > UINT32_MAX / 8 ||
+                (header.bits != 8 && header.bits != 16 && header.bits != 24 && header.bits != 32) ||
+                header.blockAlign != header.channels * (header.bits / 8) ||
+                uint64_t(header.sampleRate) * header.blockAlign != header.byteRate) return false;
+            fmtSeen = true;
+        } else if (!std::memcmp(data + p, "data", 4)) {
+            if (!fmtSeen || !chunkSize || chunkSize % header.blockAlign) return false;
+            header.dataStart = uint32_t(p + 8);
+            header.dataSize = chunkSize;
+            result = header;
+            return true;
+        }
+        const uint64_t next = end + (chunkSize & 1);
+        if (next > size) return false; // header must fit the bounded response
+        p = size_t(next);
+    }
+    return false;
+}
+inline bool target(const Header& header, uint16_t seconds, uint32_t& result) {
+    if (!header.blockAlign || !header.byteRate) return false;
+    const uint64_t offset = uint64_t(seconds) * header.byteRate;
+    const uint64_t aligned = offset - offset % header.blockAlign;
+    if (aligned >= header.dataSize || uint64_t(header.dataStart) + aligned > INT32_MAX) return false;
+    result = header.dataStart + uint32_t(aligned);
+    return true;
+}
+} // namespace radio_fast_wav
