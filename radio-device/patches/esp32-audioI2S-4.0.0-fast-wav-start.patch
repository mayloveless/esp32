+    // m_f_stream is still false, so no PCM decoding can start yet.
+    if (!initializeDecoder()) return fail(9);
+    if (xSemaphoreTake(mutex_audioTaskIsDecoding, 1 * configTICK_RATE_HZ) != pdTRUE) return fail(8);
+    m_f_lockInBuffer = true;
+    m_decoder->setRawBlockParams(wav.channels, wav.sampleRate, wav.bits, 0, 0);
+    m_audioDataStart = wav.dataStart;
+    m_audioDataSize = wav.dataSize;
