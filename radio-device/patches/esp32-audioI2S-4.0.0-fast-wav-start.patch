+    m_f_firstPlayCall = false;
+    m_pad.count = 0;
+    m_pad.oldAudioDataSize = 0;
+    m_bytesNotConsumed = 0;
+    m_pad.lastFrames = false;
+    m_f_eof = false;
+    m_resumeFilePos = -1;
+    m_controlCounter = 100;
+    m_f_acceptRanges = true;
+    m_f_firstCall = false;
+    m_f_allDataReceived = false;
+    m_pwf.audioHeaderFound = true;
+    m_pwf.newFilePos = target;
+    m_pwf.ctime = millis();
+    m_pwf.timeout = 8000;
+    m_pwf.maxFrameSize = InBuff.getMaxBlockSize();
+    // Same two-block prefill and 3 s timeout as the legacy WAV seek patch.
+    const uint32_t prefill = std::min<uint32_t>(wav.dataSize - (target - wav.dataStart), 2 * InBuff.getMaxBlockSize());
+    InBuff.reset();
+    const int32_t read = audioFileRead(InBuff.getWritePtr(), prefill, 3000);
+    if (prefill < InBuff.getMaxBlockSize() || read != prefill) {
+        m_f_lockInBuffer = false;
+        xSemaphoreGive(mutex_audioTaskIsDecoding);
